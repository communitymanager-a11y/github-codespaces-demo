{
  // VSCode 標準の AI 機能（Copilot Chat・インライン補完など）を非表示にする。
  // 参加者が Claude Code 拡張と混同しないようにするため。
  "chat.disableAIFeatures": true,

  // Claude Code 拡張のサインイン画面を出さず、環境変数 ANTHROPIC_API_KEY（Codespaces の Secret）で認証する
  "claudeCode.disableLoginPrompt": true,

  // 長い行を折り返して、横スクロールなしで読めるようにする
  "editor.wordWrap": "on",

  // 行番号を表示する（Notebook のセルは既定で非表示のため明示する）
  "editor.lineNumbers": "on",
  "notebook.lineNumbers": "on",

  // 保存忘れを防ぐため、編集後に自動保存する
  "files.autoSave": "afterDelay",

  // 画面を広く使うため、右端のミニマップを非表示にする
  "editor.minimap.enabled": false
}
