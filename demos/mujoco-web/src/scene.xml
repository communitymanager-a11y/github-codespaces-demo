<!-- 検証用の簡易ロボットアーム（プリミティブのみ。メッシュファイル不要） -->
<mujoco model="simple-arm">
  <compiler angle="radian"/>
  <option timestep="0.002" cone="elliptic" impratio="10"/>

  <default>
    <joint damping="2" armature="0.01"/>
    <geom friction="1.5 0.02 0.001" solref="0.005 1"/>
    <position kp="80" ctrlrange="-3.14 3.14"/>
    <!-- ロボットの部品同士は衝突させず、床と箱とだけ衝突させる -->
    <default class="robot">
      <geom contype="2" conaffinity="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" contype="1" conaffinity="3" size="1 1 0.05" rgba="0.85 0.87 0.9 1"/>

    <!-- 台座 -->
    <geom name="base" class="robot" type="cylinder" pos="0 0 0.025" size="0.07 0.025" rgba="0.25 0.27 0.32 1"/>

    <body name="turret" pos="0 0 0.05" childclass="robot">
      <joint name="yaw" type="hinge" axis="0 0 1"/>
      <geom type="cylinder" pos="0 0 0.03" size="0.05 0.03" rgba="0.95 0.55 0.15 1"/>

      <body name="upper_arm" pos="0 0 0.08">
        <joint name="shoulder" type="hinge" axis="0 1 0" range="-1.6 1.6"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.22" size="0.025" rgba="0.95 0.55 0.15 1"/>

        <body name="forearm" pos="0 0 0.22">
          <joint name="elbow" type="hinge" axis="0 1 0" range="0 2.6"/>
          <geom type="capsule" fromto="0 0 0 0 0 0.2" size="0.02" rgba="0.3 0.6 0.95 1"/>

          <body name="hand" pos="0 0 0.21">
            <joint name="wrist" type="hinge" axis="0 1 0" range="-3 3"/>
            <geom type="box" size="0.02 0.05 0.01" rgba="0.25 0.27 0.32 1"/>

            <body name="finger_left" pos="0 0.04 0.04">
              <joint name="finger_left" type="slide" axis="0 1 0" range="-0.035 0" damping="5"/>
              <geom type="box" size="0.012 0.006 0.03" rgba="0.2 0.2 0.22 1" mass="0.02"/>
            </body>
            <body name="finger_right" pos="0 -0.04 0.04">
              <joint name="finger_right" type="slide" axis="0 -1 0" range="-0.035 0" damping="5"/>
              <geom type="box" size="0.012 0.006 0.03" rgba="0.2 0.2 0.22 1" mass="0.02"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- つかむ対象の箱 -->
    <body name="cube" pos="0.3 0 0.025">
      <freejoint/>
      <geom name="cube" type="box" contype="1" conaffinity="3" size="0.022 0.022 0.022" rgba="0.9 0.2 0.25 1" mass="0.03"/>
    </body>
  </worldbody>

  <actuator>
    <position name="yaw" joint="yaw" kp="60"/>
    <position name="shoulder" joint="shoulder" kp="120" ctrlrange="-1.6 1.6"/>
    <position name="elbow" joint="elbow" kp="80" ctrlrange="0 2.6"/>
    <position name="wrist" joint="wrist" kp="20" ctrlrange="-3 3"/>
    <position name="finger_left" joint="finger_left" kp="300" ctrlrange="-0.035 0"/>
    <position name="finger_right" joint="finger_right" kp="300" ctrlrange="-0.035 0"/>
  </actuator>
</mujoco>
